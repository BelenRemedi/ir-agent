# Copy this file to .env and fill in your values

# Required: Your API key (OpenAI format)
# For Berget.AI: https://berget.ai — use code HACKTHON26 for free credits
OPENAI_API_KEY=your-api-key-here

# Required: API base URL
# Berget.AI: https://api.berget.ai/v1
# OpenAI:    https://api.openai.com/v1
OPENAI_BASE_URL=https://api.berget.ai/v1

# Required: Model name
# Berget.AI supports: llama-3.3-70b-instruct, meta-llama-3.1-70b-instruct, etc.
# OpenAI supports: gpt-4o-mini, gpt-4o, etc.
OPENAI_MODEL=llama-3.3-70b-instruct

# Optional: Brave Search API key for better web search results
# Get one free at https://brave.com/search/api/
# Without this, DuckDuckGo Instant Answers are used as fallback
BRAVE_SEARCH_API_KEY=

# Optional: Port for web UI (default: 5000)
PORT=5000
